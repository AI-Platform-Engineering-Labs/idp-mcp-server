{
  // VS Code (Copilot agent mode) MCP servers for this repo.
  // Pick ONE in the MCP: List Servers view and click Start.
  // First start the local stack (docker compose up -d, or terraform apply in infra/local).
  "servers": {
    // 1) stdio: VS Code starts an MCP server container itself and talks over stdin/stdout.
    //    It joins the local "idp" Docker network to reach Backstage.
    "idp-local-stdio": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run", "-i", "--rm", "--network", "idp",
        "-e", "BACKSTAGE_URL=http://backstage:7007",
        "-e", "BACKSTAGE_TOKEN=local-dev-token-change-me",
        "idp-mcp-server:local", "--transport", "stdio"
      ]
    },
    // 2) HTTP: the MCP server container from the local stack.
    "idp-local-http": {
      "type": "http",
      "url": "http://localhost:8000/mcp"
    },
    // 3) AKS: the MCP endpoint from the deploy-azure run summary.
    "idp-aks": {
      "type": "http",
      "url": "${input:aksMcpUrl}"
    }
  },
  "inputs": [
    {
      "id": "aksMcpUrl",
      "type": "promptString",
      "description": "MCP endpoint from the deploy-azure run summary, e.g. http://20.1.2.3/mcp"
    }
  ]
}
